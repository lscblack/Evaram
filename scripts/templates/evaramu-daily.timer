# sudo cp scripts/templates/evaramu-daily.{service,timer} /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now evaramu-daily.timer
[Unit]
Description=Run Evaramu daily rent jobs every morning

[Timer]
OnCalendar=*-*-* 05:30:00
Persistent=true

[Install]
WantedBy=timers.target
