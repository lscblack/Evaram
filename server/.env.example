# ---------------------------------------------------------------------------
# Evaramu Property & Rent Management Platform — server configuration
# Copy to server/.env and fill in. Real environment variables override this file.
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
DEBUG=false
# REQUIRED in production: at least 32 random characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=evaramu
DB_SSLMODE=disable
# Optional: database used by the automated test-suite (defaults to <DB_NAME>_test).
# It is created/wiped by the tests — never point it at a real database.
# TEST_DB_NAME=evaramu_test

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public URL of the site (used for links in notifications); optional.
PUBLIC_SITE_URL=http://localhost:5173

# Where uploaded property photographs and payment evidence are stored.
# Keep it OUTSIDE the frontend build directory so deployments never delete it.
MEDIA_ROOT=./storage/media
PRIVATE_ROOT=./storage/private
MAX_UPLOAD_MB=8

# Auth
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Set to true when the site is served over HTTPS (production).
COOKIE_SECURE=false

# Optional bootstrap administrator. scripts/migrate.sh (run by dev/deploy) creates
# this account if it does not exist yet; an existing account is never modified.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Administrator

# ---- Email (sign-in codes). smtp | file (development only) | disabled ----
MAIL_BACKEND=disabled
MAIL_FROM=Evaramu <no-reply@evaramu.rw>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (port 587) | ssl (port 465) | none
SMTP_SECURITY=starttls

# ---- Passkeys: default to the host/origin of PUBLIC_SITE_URL ----
# WEBAUTHN_RP_ID=evaramu.rw
# WEBAUTHN_ORIGINS=https://evaramu.rw
